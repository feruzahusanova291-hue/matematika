# Telegram Bot Token (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API kaliti (https://aistudio.google.com/apikey orqali olinadi)
GEMINI_API_KEY=your_gemini_api_key_here

# Ixtiyoriy sozlamalar:
GEMINI_MODEL=gemini-3.5-flash
SYSTEM_INSTRUCTION_FILE=system_instruction.json
MAX_HISTORY_MESSAGES=16
COOLDOWN_SECONDS=2
# ALLOWED_USER_IDS=12345678,87654321
